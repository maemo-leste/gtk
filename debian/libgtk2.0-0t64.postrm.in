#!/bin/sh

set -e

#DEBHELPER#

case "$1" in
    (purge)
        if [ -d /@MODULES_BASE_PATH@ ] && ! [ -e /@MODULES_BASE_PATH@/immodules ]; then
            # Purge the cache
            rm -f /@MODULES_BASE_PATH@/immodules.cache
            rmdir -p --ignore-fail-on-non-empty /@MODULES_BASE_PATH@
        fi
        ;;
esac
